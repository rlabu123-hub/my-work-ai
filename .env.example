NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never add NEXT_PUBLIC_ to OpenAI credentials.
OPENAI_API_KEY=
# Codex cloud proxy secret alias (standard OPENAI_ secret target names are reserved)
WORK_AI_OPENAI_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Public HTTPS URL for email authentication redirects and remote MCP metadata
APP_URL=http://localhost:3000
